# Copy to .env.test and use a dedicated, disposable Supabase test project.
NODE_ENV=test
PORT=0

# Copy the Session Pooler connection string from the test project's Connect panel.
# URL-encode special characters in the database password.
TEST_DATABASE_URL=

# Test-only seed account password; never reuse production credentials.
TEST_DEMO_USER_PASSWORD=TestOnly123!

# The integration suites set these explicitly before loading the app.
DATABASE_URL=
DEMO_USER_PASSWORD=
JWT_SECRET=test-only-secret-change-this-before-use-123456
CORS_ORIGINS=https://portal.example.test
OVERDUE_FINE_DAILY_RATE=2000

# Supabase pooler TLS certificate authority used by this workspace.
# Download the test project's CA from Supabase if this file is unavailable.
PG_CA_CERT_PATH=./certs/prod-ca-2021.crt

# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD and DB_SSL are not read by
# this application. It uses TEST_DATABASE_URL; TLS certificate verification is
# enforced in src/config/database.js.
