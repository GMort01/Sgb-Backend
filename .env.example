# Copy this file to .env and fill in the values locally.
# Use the Supabase Session Pooler URL (port 5432); never commit .env.
DATABASE_URL=
DEMO_USER_PASSWORD=
JWT_SECRET=
PG_CA_CERT_PATH=./certs/prod-ca-2021.crt
CORS_ORIGINS=http://localhost:5173
OVERDUE_FINE_DAILY_RATE=2000

# Optional: run the integration test only against a disposable, isolated database.
TEST_DATABASE_URL=
TEST_DEMO_USER_PASSWORD=
